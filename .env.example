# Copy to .env to customize host ports. Container ports stay fixed.
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
SYSLOG_PORT=1514
SYSLOG_RFC5424_PORT=1515
ALLOY_PORT=12345

# Optional host directory instead of the lgtm-data named volume.
# Useful on macOS when the Podman VM disk is full but the host has free space.
# LGTM_DATA_PATH=./.data/lgtm
